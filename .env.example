OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# Remote/autopilot settings
APP_URL=https://your-deployed-domain.example
APP_TIMEZONE=Africa/Johannesburg
CRON_SECRET=generate-a-long-random-secret
PUBLISH_SECRET=optional-separate-publish-secret
DAILY_PUBLISH_TIME=20:00

# Metricool server-side credentials. Never expose these in browser code.
METRICOOL_API_TOKEN=your_metricool_rest_api_token
METRICOOL_USER_ID=your_metricool_user_id
METRICOOL_BLOG_ID=your_metricool_brand_id
METRICOOL_API_BASE_URL=https://app.metricool.com/api
YOUTUBE_PRIVACY=public
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE

# A remote video renderer must return { "mediaUrl": "https://..." }.
# If this is missing, the autopilot intentionally stops before publishing.
VIDEO_RENDER_WEBHOOK_URL=https://your-video-renderer.example/render
VIDEO_RENDER_SECRET=optional-renderer-secret

# Analytics + AI Growth Manager
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
ANALYTICS_INGEST_SECRET=optional-separate-analytics-secret

# Audience Intelligence
AUDIENCE_INGEST_SECRET=optional-separate-audience-secret

# Optional server-side adapter that returns normalized Metricool analytics records
# The adapter should return: { "records": [PerformanceRecord, ...] }
METRICOOL_ANALYTICS_ADAPTER_URL=https://your-analytics-adapter.example/sync
METRICOOL_ANALYTICS_ADAPTER_SECRET=optional-adapter-secret

# Content experimentation
EXPERIMENT_SECRET=optional-separate-experiment-secret

# Platform optimization
# Platform-specific title/caption/hashtag packaging is generated server-side.

# Production hardening
# Autonomous publishing requires persistent Upstash Redis; in-memory fallback is not sufficient.
AUTOPILOT_ENABLED=false

# V16 Autonomous Content Orchestrator
# The orchestrator endpoint is protected by CRON_SECRET and is the production cron target.

# V24 AI creative asset generation
CREATIVE_ASSETS_ENABLED=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
