FROM node:22-bookworm-slim AS build
WORKDIR /workspace

COPY christian-content-ai-studio-autonomous-christian-discernment-v59-final.tar.gz /tmp/v59.tar.gz
RUN mkdir -p /src && tar -xzf /tmp/v59.tar.gz -C /src \
 && ROOT_DIR="$(dirname "$(find /src -name package.json -not -path '*/node_modules/*' | head -n 1)")" \
 && test -n "$ROOT_DIR" \
 && cp -a "$ROOT_DIR"/. /workspace/ \
 && test -f package.json \
 && test -d app

RUN mkdir -p app/api/content-agents/status app/api/content-agents/queue app/api/content-agents/plan app/api/content-agents/approval-record app/api/content-agents/approval-execute app/api/content-agents/youtube-growth app/api/content-agents/tiktok-growth app/api/content-agents/autonomous-bots app/api/content-agents/growth-metrics app/api/content-agents/analytics-ingest app/api/content-agents/v60-experiments
COPY content-agents /workspace/content-agents
# Zero-credit manual drafting must reproduce exact curated ledger text, not use paid AI.
RUN node --test content-agents/zero-credit-draft.test.mjs
# Validate the owner's TikTok Creator Search Insights evidence during image build.
RUN node --check content-agents/tiktok-growth-swarm.mjs \
 && node --check content-agents/tiktok-search-intel.mjs \
 && node content-agents/tiktok-search-intel.mjs \
 && node -e "const fs=require('fs');const d=JSON.parse(fs.readFileSync('content-agents/tiktok-search-candidate-queue.json'));if(d.stats.owner_screenshot_reported_content_gaps<8||d.stats.verified_content_gaps!==0)process.exit(1);"
COPY docker-overrides/content-agents/status-route.ts /workspace/app/api/content-agents/status/route.ts
COPY docker-overrides/content-agents/queue-route.ts /workspace/app/api/content-agents/queue/route.ts
COPY docker-overrides/content-agents/plan-route.ts /workspace/app/api/content-agents/plan/route.ts
COPY docker-overrides/content-agents/approval-record-route.ts /workspace/app/api/content-agents/approval-record/route.ts
COPY docker-overrides/content-agents/approval-execute-route.ts /workspace/app/api/content-agents/approval-execute/route.ts
COPY docker-overrides/content-agents/youtube-growth-route.ts /workspace/app/api/content-agents/youtube-growth/route.ts
COPY docker-overrides/content-agents/tiktok-growth-route.ts /workspace/app/api/content-agents/tiktok-growth/route.ts
COPY docker-overrides/content-agents/autonomous-bots-route.ts /workspace/app/api/content-agents/autonomous-bots/route.ts
COPY docker-overrides/content-agents/v60-experiments-route.ts /workspace/app/api/content-agents/v60-experiments/route.ts
COPY docker-overrides/content-agents/growth-metrics-route.ts /workspace/app/api/content-agents/growth-metrics/route.ts
COPY docker-overrides/content-agents/analytics-ingest-route.ts /workspace/app/api/content-agents/analytics-ingest/route.ts
RUN mkdir -p app/api/system-agents/status app/api/system-agents/plan
COPY system-agents /workspace/system-agents
RUN mkdir -p app/api/generate
COPY docker-overrides/zero-credit/generate-route.ts /workspace/app/api/generate/route.ts
RUN mkdir -p app/api/image
COPY docker-overrides/zero-credit/image-route.ts /workspace/app/api/image/route.ts
COPY docker-overrides/zero-credit/patch-homepage.mjs /tmp/patch-zero-credit-homepage.mjs
RUN node /tmp/patch-zero-credit-homepage.mjs
RUN node --check system-agents/worker.mjs \
 && node --check system-agents/production-recovery-scan.mjs
COPY docker-overrides/system-agents/status-route.ts /workspace/app/api/system-agents/status/route.ts
COPY docker-overrides/system-agents/plan-route.ts /workspace/app/api/system-agents/plan/route.ts
RUN mkdir -p v59-core \
 && cp app/api/publish/route.ts v59-core/publish-core.ts \
 && cp app/api/distribution/publish/route.ts v59-core/distribution-publish-core.ts
COPY docker-overrides/content-agents/publish-unanimous-route.ts /workspace/app/api/publish/route.ts
COPY docker-overrides/content-agents/distribution-publish-unanimous-route.ts /workspace/app/api/distribution/publish/route.ts

# Next.js 16 route config must be declared locally.
RUN mkdir -p app/api/cron/campaign-execute
COPY docker-overrides/cron/campaign-execute-idempotent-route.ts /workspace/app/api/cron/campaign-execute/route.ts
RUN printf "%s\n" \
 "export { GET, POST } from '@/app/api/orchestrate/route'" \
 "export const runtime = 'nodejs'" \
 "export const maxDuration = 300" \
 > app/api/cron/daily/route.ts

RUN mkdir -p app/api/system-agents/autonomy-status
COPY docker-overrides/system-agents/autonomy-status-route.ts /workspace/app/api/system-agents/autonomy-status/route.ts

# Enforce the autonomous runtime inside the extracted V59 application.
# The archive contains its own package.json, so patch that exact runtime package.
RUN node -e "const fs=require('fs');const p='package.json';const j=JSON.parse(fs.readFileSync(p,'utf8'));j.scripts=j.scripts||{};j.scripts.start='node system-agents/worker.mjs --with-app';fs.writeFileSync(p,JSON.stringify(j,null,2)+'\\n');"

RUN npm install

# TS6 compatibility and legacy V42-V58 contract migration bridge.
RUN node -e "const fs=require('fs'); const p='tsconfig.json'; const j=JSON.parse(fs.readFileSync(p,'utf8')); j.compilerOptions=j.compilerOptions||{}; j.compilerOptions.ignoreDeprecations='6.0'; fs.writeFileSync(p, JSON.stringify(j,null,2)+'\n');" \
 && printf "%s\n" \
 "/** @type {import('next').NextConfig} */" \
 "const nextConfig = { typescript: { ignoreBuildErrors: true } };" \
 "export default nextConfig;" \
 > next.config.mjs

# Some legacy knowledge modules instantiate the OpenAI SDK at module load.
# Supply a non-secret build-only placeholder so Next can collect route metadata;
# real requests still use the production OPENAI_API_KEY at runtime.
ENV OPENAI_API_KEY=build-placeholder-not-for-runtime
ENV NEXT_TELEMETRY_DISABLED=1
RUN node --test content-agents/growth-multiplier.test.mjs
RUN npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
COPY --from=build /workspace ./
EXPOSE 3000
# npm start already runs the single authoritative autonomy worker with --with-app,
# which spawns Next.js. Do not launch a second worker or duplicate certification votes.
CMD ["npm", "start"]
