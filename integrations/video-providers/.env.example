# Copy to .env; never commit .env to GitHub.
# Generate a strong password/token: openssl rand -hex 32
OMS_LOCAL_TOKEN=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_TOKEN
# 127.0.0.1: computer only. Set 0.0.0.0 ONLY on a trusted LAN if phone needs access.
OMS_BIND_ADDRESS=127.0.0.1
OMS_PORT=8787

# Optional: secure, reachable GPU machine running ComfyUI with a tested LTX template.
# For a ComfyUI running on the same computer but outside Docker, use
# http://host.docker.internal:8188 AND configure host-gateway in compose if Linux.
# Remote ComfyUI requires HTTPS and compatible token auth.
COMFYUI_URL=
COMFYUI_API_TOKEN=
LTX_WORKFLOW_CONFIGURED=false

# Billing safeguard, leave this enabled.
ZERO_CREDIT_ONLY=true
# HF credentials should be kept server-side. The local dashboard NEVER submits paid HF jobs.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
